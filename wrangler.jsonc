{
  // Cloudflare Worker that serves elbrando.com.
  // It reads the pages in /public from this repo's main branch on GitHub (see src/index.js),
  // so page edits go live without redeploying. Only changes to src/index.js need a redeploy.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "elbrando",
  "main": "src/index.js",
  "compatibility_date": "2026-11-19",
  "workers_dev": false,

  // The addresses this Worker answers on.
  "routes": [
    { "pattern": "elbrando.com", "custom_domain": true },
    { "pattern": "www.elbrando.com", "custom_domain": true }
  ]
}
